---
import { t, type Lang } from '../i18n/utils';
interface Props { lang: Lang; courseKey: string; lessonId: string; prevUrl?: string; nextUrl?: string; notesUrl: string; extraClass?: string }
const { lang, courseKey, lessonId, prevUrl, nextUrl, notesUrl, extraClass } = Astro.props;
---
<div class:list={['lesson-nav', extraClass]}>
  {prevUrl ? <a class="nav-button" href={prevUrl}>← {t(lang, 'lesson.previousLong')}</a> : <button type="button" disabled>← {t(lang, 'lesson.previousLong')}</button>}
  <button type="button" id="completeLesson" class="complete-toggle" aria-pressed="false" data-complete={`${courseKey}/${lessonId}`}
    data-label-todo={t(lang, 'lesson.complete')} data-label-done={t(lang, 'lesson.completedUndo')}
    data-toast-done={t(lang, 'toast.complete')} data-toast-todo={t(lang, 'toast.incomplete')} title={t(lang, 'lesson.completeHint')}>
    <span class="complete-check" aria-hidden="true">✓</span><span data-complete-label>{t(lang, 'lesson.complete')}</span>
  </button>
  {nextUrl ? <a class="nav-button" href={nextUrl}>{t(lang, 'lesson.nextLong')} →</a> : <a class="nav-button" href={notesUrl}>{t(lang, 'cornell.link')} →</a>}
</div>
