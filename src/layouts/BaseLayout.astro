---
import '../styles/legacy.css';
import '../styles/site.css';
import { href, languages, langs, t, type Lang } from '../i18n/utils';
import SyncPanel from '../components/SyncPanel.astro';

interface Props {
  lang: Lang;
  title: string;
  description?: string;
  /** Path after the language prefix, used by the language switcher (e.g. "oop/classes"). */
  path?: string;
  /** Show the mobile lesson-menu button (pages with a sidebar). */
  hasSidebar?: boolean;
}
const { lang, title, description = t(lang, 'site.description'), path = '', hasSidebar = false } = Astro.props;
const searchIndexUrl = href(lang, 'search.json').replace(/\/$/, '');
---
<!doctype html>
<html lang={lang} data-theme="light">
<head>
  <meta charset="utf-8" />
  <meta name="viewport" content="width=device-width, initial-scale=1" />
  <meta name="theme-color" content="#101827" />
  <meta name="description" content={description} />
  <title>{title} · Learning Everything</title>
  <link rel="icon" type="image/svg+xml" href={href('favicon.svg').replace(/\/$/, '')} />
  <link rel="preconnect" href="https://fonts.googleapis.com" />
  <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
  <link href="https://fonts.googleapis.com/css2?family=DM+Mono:wght@400;500&family=DM+Sans:wght@400;500;600;700;800&family=Manrope:wght@400;500;600;700;800&display=swap" rel="stylesheet" />
  <script is:inline>
    try {
      var saved = localStorage.getItem('le:theme');
      var theme = saved === 'dark' || saved === 'light' ? saved : (matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light');
      document.documentElement.dataset.theme = theme;
    } catch (e) {}
  </script>
</head>
<body>
  <header class="lab-topbar">
    <a class="lab-brand" href={href(lang)} aria-label={t(lang, 'nav.home')}>
      <svg class="brand-icon" viewBox="0 0 32 32" aria-hidden="true" focusable="false"><path d="M5 7.5c4.5-.9 8.2.1 11 2.6v16c-2.8-2.5-6.5-3.5-11-2.6zM27 7.5c-4.5-.9-8.2.1-11 2.6v16c2.8-2.5 6.5-3.5 11-2.6z"/><path d="M22.8 4.2v4.2M20.7 6.3h4.2" class="brand-spark"/></svg>
      <span>Learning <b>Everything</b></span>
    </a>
    <nav class="global-nav" aria-label={t(lang, 'nav.main')}><a class="selected" href={href(lang)}>{t(lang, 'nav.courses')}</a></nav>
    <div class="header-tools">
      <div class="lang-menu" data-lang-menu>
        <button type="button" class="lang-trigger" aria-haspopup="true" aria-expanded="false" aria-controls="langMenuList" aria-label={`${t(lang, 'nav.language')}: ${languages[lang]}`}>
          <svg class="lang-globe" viewBox="0 0 20 20" aria-hidden="true"><circle cx="10" cy="10" r="7.5"/><path d="M2.5 10h15M10 2.5c2.2 2.1 3.3 4.6 3.3 7.5S12.2 15.4 10 17.5M10 2.5C7.8 4.6 6.7 7.1 6.7 10s1.1 5.4 3.3 7.5"/></svg>
          <span class="lang-name">{languages[lang]}</span>
          <span class="lang-code">{lang.toUpperCase()}</span>
          <svg class="lang-chevron" viewBox="0 0 12 12" aria-hidden="true"><path d="M3 4.5l3 3 3-3"/></svg>
        </button>
        <ul class="lang-list" id="langMenuList" role="menu" aria-label={t(lang, 'nav.language')} hidden>
          {langs.map((code) => (
            <li role="none">
              <a role="menuitemradio" aria-checked={code === lang ? 'true' : 'false'} href={href(code, ...(path ? path.split('/') : []))} hreflang={code} lang={code} data-lang-option={code}>
                <span class="lang-badge">{code.toUpperCase()}</span>
                <span class="lang-label">{languages[code]}</span>
                <svg class="lang-check" viewBox="0 0 16 16" aria-hidden="true"><path d="M3 8.5l3 3 7-7"/></svg>
              </a>
            </li>
          ))}
        </ul>
      </div>
      <SyncPanel {lang} />
      <button class="theme-switch" id="themeToggle" type="button" role="switch" aria-checked="false" aria-label={t(lang, 'theme.dark')} title={t(lang, 'theme.toDark')} data-to-dark={t(lang, 'theme.toDark')} data-to-light={t(lang, 'theme.toLight')}>
        <span class="theme-track" aria-hidden="true">
          <svg class="theme-bg-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
          <svg class="theme-bg-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          <span class="theme-thumb">
            <svg class="theme-sun" viewBox="0 0 24 24"><circle cx="12" cy="12" r="4"/><path d="M12 2v2M12 20v2M4.9 4.9l1.4 1.4M17.7 17.7l1.4 1.4M2 12h2M20 12h2M4.9 19.1l1.4-1.4M17.7 6.3l1.4-1.4"/></svg>
            <svg class="theme-moon" viewBox="0 0 24 24"><path d="M20 14.5A8 8 0 0 1 9.5 4a8 8 0 1 0 10.5 10.5z"/></svg>
          </span>
        </span>
      </button>
      <div class="search-wrap">
        <label class="search-box"><span aria-hidden="true">⌕</span><input id="siteSearch" type="search" placeholder={t(lang, 'search.placeholder')} aria-label={t(lang, 'search.placeholder')} autocomplete="off" data-index={searchIndexUrl} data-empty={t(lang, 'search.empty')} /></label>
        <div class="search-results" id="searchResults" role="listbox" hidden></div>
      </div>
      {hasSidebar && <button class="mobile-menu" id="menuToggle" type="button" aria-expanded="false" aria-controls="lessonSidebar" aria-label={t(lang, 'nav.openMenu')} data-open={t(lang, 'nav.openMenu')} data-close={t(lang, 'nav.closeMenu')}>☰</button>}
    </div>
  </header>
  <slot />
  <div class="toast" id="toast" role="status" aria-live="polite"></div>
  <script>
    import '../scripts/app.ts';
  </script>
</body>
</html>
