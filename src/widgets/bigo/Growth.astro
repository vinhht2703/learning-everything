---
import { strings, t } from '../../i18n/utils';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
const legend = [['constant', 'O(1)'], ['log', 'O(log n)'], ['linear', 'O(n)'], ['nlogn', 'O(n log n)'], ['quadratic', 'O(n²)'], ['exponential', 'O(2ⁿ)']];
---
<div data-widget="bigo-growth" data-strings={JSON.stringify(strings(lang, 'w.growth.'))}>
  <label class="n-picker">{t(lang, 'w.growth.inputSize')} <strong>n = <span data-n>8</span></strong><input type="range" min="2" max="12" value="8" /></label>
  <div class="growth-layout">
    <div class="growth-chart-card">
      <div class="chart-legend">{legend.map(([id, name]) => <span><i class={`legend-${id}`}></i>{name}</span>)}</div>
      <svg id="growthChart" viewBox="0 0 680 290" role="img" aria-label={t(lang, 'w.growth.aria')}></svg>
      <div class="chart-axis-labels"><span>{t(lang, 'w.growth.axisX')}</span><span>{t(lang, 'w.growth.axisY')}</span></div>
    </div>
    <div class="growth-insights" aria-live="polite" data-insights></div>
  </div>
</div>
<script>
  import { $, eachWidget, escapeHtml, fmt } from '../../lib/dom';
  const series = [
    { id: 'constant', name: 'O(1)', color: '#20a78b', fn: () => 1 },
    { id: 'log', name: 'O(log n)', color: '#4386ed', fn: (v: number) => Math.log2(v) },
    { id: 'linear', name: 'O(n)', color: '#be8c1b', fn: (v: number) => v },
    { id: 'nlogn', name: 'O(n log n)', color: '#9764d5', fn: (v: number) => v * Math.log2(v) },
    { id: 'quadratic', name: 'O(n²)', color: '#ee7765', fn: (v: number) => v * v },
    { id: 'exponential', name: 'O(2ⁿ)', color: '#c84170', fn: (v: number) => 2 ** v },
  ];
  eachWidget('bigo-growth', (root, s) => {
    const input = $<HTMLInputElement>(root, 'input');
    const svg = $(root, 'svg');
    const draw = () => {
      const n = Number(input.value);
      $(root, '[data-n]').textContent = String(n);
      const left = 48, right = 666, top = 16, bottom = 246;
      const x = (v: number) => left + ((v - 1) / 11) * (right - left);
      const y = (v: number) => bottom - (Math.log10(Math.max(1, v)) / 4) * (bottom - top);
      const grid = [1, 10, 100, 1000, 10000].map((v) => `<line x1="${left}" y1="${y(v)}" x2="${right}" y2="${y(v)}" class="chart-grid"/><text x="${left - 8}" y="${y(v) + 3}" text-anchor="end" class="chart-label">${v >= 1000 ? `${v / 1000}k` : v}</text>`).join('');
      const xTicks = [1, 3, 5, 7, 9, 11, 12].map((v) => `<text x="${x(v)}" y="${bottom + 18}" text-anchor="middle" class="chart-label">${v}</text>`).join('');
      const curves = series.map((item) => `<polyline class="chart-path" stroke="${item.color}" points="${Array.from({ length: 12 }, (_, i) => `${x(i + 1)},${y(item.fn(i + 1))}`).join(' ')}"/>`).join('');
      const markers = series.map((item) => `<circle class="chart-marker" cx="${x(n)}" cy="${y(item.fn(n))}" r="4" fill="${item.color}"/>`).join('');
      svg.innerHTML = `${grid}<line x1="${left}" y1="${top}" x2="${left}" y2="${bottom}" class="chart-axis"/><line x1="${left}" y1="${bottom}" x2="${right}" y2="${bottom}" class="chart-axis"/>${xTicks}${curves}${markers}<line x1="${x(n)}" y1="${top}" x2="${x(n)}" y2="${bottom}" stroke="#93a2b7" stroke-dasharray="3 4"/><text x="${x(n)}" y="${top - 3}" text-anchor="middle" class="chart-label">n=${n}</text>`;
      $(root, '[data-insights]').innerHTML = series.map((item) => {
        const value = item.fn(n);
        const display = value >= 1000 ? `${(value / 1000).toFixed(1)}k` : String(Math.round(value * 10) / 10);
        return `<article class="growth-insight"><strong><i style="background:${item.color}"></i>${item.name}<span>${escapeHtml(fmt(s.ops, { n: display }))}</span></strong><p>${escapeHtml(s[item.id])}</p></article>`;
      }).join('');
    };
    input.addEventListener('input', draw);
    draw();
  });
</script>
