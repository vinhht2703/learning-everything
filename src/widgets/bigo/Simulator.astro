---
import { strings, t } from '../../i18n/utils';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
const k = (key: string) => t(lang, `w.sim.${key}`);
---
<div data-widget="bigo-sim" data-strings={JSON.stringify(strings(lang, 'w.sim.'))}>
  <div class="sim-controls">
    <label>{k('algorithm')}<select data-mode>
      <option value="binary">{k('binary')} · O(log n)</option><option value="linear">{k('linear')} · O(n)</option>
      <option value="nested">{k('nested')} · O(n²)</option><option value="branch">{k('branch')} · O(2ⁿ)</option>
    </select></label>
    <label>{k('inputSize')} <strong>n = <span data-n>8</span></strong><input type="range" min="4" max="16" value="8" /></label>
    <div class="sim-buttons"><button class="run-button" type="button" data-play><span>▶</span> {k('play')}</button><button class="reset-button" type="button" data-next>{k('next')}</button><button class="reset-button" type="button" data-reset>{k('reset')}</button></div>
  </div>
  <div class="sim-status"><div><span>{k('complexity')}</span><strong data-complexity>O(log n)</strong></div><div><span>{k('operations')}</span><strong data-count>0 / 4</strong></div><p data-explanation>{k('ready')}</p></div>
  <div class="sim-visual" aria-live="polite" data-visual></div>
</div>
<script>
  import { $, eachWidget, fmt } from '../../lib/dom';
  type Step = { current?: number; low?: number; high?: number; row?: number; col?: number; level?: number; message: string };
  const labels: Record<string, string> = { binary: 'O(log n)', linear: 'O(n)', nested: 'O(n²)', branch: 'O(2ⁿ)' };
  eachWidget('bigo-sim', (root, s) => {
    const mode = $<HTMLSelectElement>(root, '[data-mode]'), slider = $<HTMLInputElement>(root, 'input'), play = $(root, '[data-play]'), visual = $(root, '[data-visual]');
    let steps: Step[] = [], index = 0, timer: number | undefined;
    const build = () => {
      const n = Number(slider.value);
      index = 0;
      steps = [];
      if (mode.value === 'binary') {
        let low = 0, high = n - 1; const target = n - 2;
        while (low <= high) {
          const mid = Math.floor((low + high) / 2);
          steps.push({ current: mid, low, high, message: fmt(s.binaryStep, { i: mid }) });
          if (mid === target) break;
          if (mid < target) low = mid + 1; else high = mid - 1;
        }
      } else if (mode.value === 'linear') {
        for (let i = 0; i < n; i++) steps.push({ current: i, low: i, high: n - 1, message: fmt(s.linearStep, { i }) });
      } else if (mode.value === 'nested') {
        for (let i = 0; i < n; i++) for (let j = i + 1; j < n; j++) steps.push({ row: i, col: j, message: fmt(s.nestedStep, { i, j }) });
      } else {
        const depth = Math.min(n, 6);
        for (let level = 0; level <= depth; level++) for (let node = 0; node < 2 ** level; node++) steps.push({ level, message: fmt(2 ** level === 1 ? s.branchStepOne : s.branchStep, { level, n: 2 ** level }) });
      }
      render();
    };
    const render = () => {
      const n = Number(slider.value);
      $(root, '[data-n]').textContent = String(n);
      $(root, '[data-complexity]').textContent = labels[mode.value];
      $(root, '[data-count]').textContent = `${Math.min(index, steps.length)} / ${steps.length}`;
      const step = steps[Math.min(index, steps.length) - 1];
      if (mode.value === 'nested') {
        visual.classList.add('sim-matrix');
        visual.innerHTML = `<div class="matrix-grid" style="--matrix-size:${n}">${Array.from({ length: n * n }, (_, i) => { const row = Math.floor(i / n), col = i % n; const cur = step && row === step.row && col === step.col; return `<span class="matrix-cell${cur ? ' pair' : ''}" title="${row}, ${col}">${row === col ? '·' : '×'}</span>`; }).join('')}</div>`;
      } else if (mode.value === 'branch') {
        visual.classList.remove('sim-matrix');
        const shown = steps.slice(0, index);
        const levels = [...new Set(shown.map((x) => x.level))];
        visual.innerHTML = levels.length ? levels.map((level) => `<div class="tree-level"><small>${fmt(s.level, { n: level! })}</small><div>${shown.filter((x) => x.level === level).map(() => '<span class="tree-node">•</span>').join('')}</div></div>`).join('') : `<span class="sim-empty">${s.treeEmpty}</span>`;
      } else {
        visual.classList.remove('sim-matrix');
        visual.innerHTML = Array.from({ length: n }, (_, i) => {
          const cur = step && i === step.current;
          const checked = mode.value === 'linear' && step && i < step.current!;
          const discarded = mode.value === 'binary' && step && (i < step.low! || i > step.high!);
          return `<span class="sim-cell${cur ? ' current' : checked ? ' checked' : discarded ? ' discarded' : ''}">${i + 1}</span>`;
        }).join('');
      }
      $(root, '[data-explanation]').textContent = step ? step.message : s.ready;
    };
    const stop = () => { clearInterval(timer); timer = undefined; play.innerHTML = `<span>▶</span> ${s.play}`; };
    const advance = () => { if (index < steps.length) index++; render(); if (index >= steps.length) stop(); };
    const reset = () => { stop(); build(); };
    play.addEventListener('click', () => {
      if (timer) { stop(); return; }
      if (index >= steps.length) index = 0;
      play.textContent = `Ⅱ ${s.pause}`;
      advance();
      if (index < steps.length) timer = window.setInterval(advance, 450);
    });
    $(root, '[data-next]').addEventListener('click', advance);
    $(root, '[data-reset]').addEventListener('click', reset);
    mode.addEventListener('change', reset);
    slider.addEventListener('input', reset);
    build();
  });
</script>
