---
import { t } from '../../i18n/utils';
import Range from '../Range.astro';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
---
<div class="linear-lab-grid" data-widget="dot">
  <div class="linear-control-grid">
    <Range label={t(lang, 'w.common.feature1')} k="x1" min={0} max={10} value={5} />
    <Range label={t(lang, 'w.common.weight1')} k="w1" min={-2} max={2} value={0.4} step={0.1} />
    <Range label={t(lang, 'w.common.feature2')} k="x2" min={0} max={10} value={3} />
    <Range label={t(lang, 'w.common.weight2')} k="w2" min={-2} max={2} value={1.2} step={0.1} />
    <Range label={t(lang, 'w.common.bias')} k="b" min={-3} max={3} value={-1} step={0.1} />
  </div>
  <div class="linear-score-card" aria-live="polite"><span>{t(lang, 'w.dot.score')}</span><strong data-score></strong><p data-detail></p></div>
</div>
<script>
  import { $, eachWidget } from '../../lib/dom';
  import { bindRanges } from '../../lib/plot';
  eachWidget('dot', (root) => {
    const update = () => {
      const [x1, x2, w1, w2, b] = ['x1', 'x2', 'w1', 'w2', 'b'].map(val);
      const score = x1 * w1 + x2 * w2 + b;
      $(root, '[data-score]').textContent = score.toFixed(2);
      $(root, '[data-detail]').textContent = `(${x1} × ${w1}) + (${x2} × ${w2}) + (${b}) = ${score.toFixed(2)}`;
    };
    const val = bindRanges(root, update);
    update();
  });
</script>
