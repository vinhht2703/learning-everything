---
import { strings, t } from '../../i18n/utils';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
const k = (key: string) => t(lang, `w.bfs.${key}`);
---
<div class="ds-widget" data-widget="dsa-bfs" data-strings={JSON.stringify(strings(lang, 'w.bfs.'))}>
  <div class="ds-buttons">
    <button class="run-button" type="button" data-step>{k('step')}</button>
    <button class="reset-button" type="button" data-play>{k('play')}</button>
    <button class="reset-button" type="button" data-reset>{k('reset')}</button>
  </div>
  <svg class="ds-tree" viewBox="0 0 680 200" role="img" aria-label={k('aria')} data-svg></svg>
  <div class="ds-inorder"><span>{k('queue')}</span><code data-queue></code></div>
  <div class="ds-inorder"><span>{k('levels')}</span><code data-levels>∅</code></div>
  <p class="ds-readout" aria-live="polite" data-readout>{k('initial')}</p>
</div>
<script>
  import { $, eachWidget, fmt } from '../../lib/dom';
  import { fromLevels, renderTree, type TNode } from '../../lib/tree';
  type Step = { queue: TNode[]; current?: TNode; visited: TNode[]; levels: (number | string)[][]; message: string };
  eachWidget('dsa-bfs', (root, s) => {
    const tree = fromLevels([4, 2, 6, 1, 3, 5, 7, null, null, 8]);
    const svg = $(root, '[data-svg]') as unknown as SVGElement;
    const steps: Step[] = [];
    { // precompute: one step per dequeued node
      let queue: TNode[] = tree ? [tree] : [];
      const visited: TNode[] = [], levels: (number | string)[][] = [];
      let level = 0;
      while (queue.length) {
        const size = queue.length;
        levels.push([]);
        for (let i = 0; i < size; i++) {
          const cur = queue.shift()!;
          visited.push(cur);
          levels[level].push(cur.key);
          for (const c of [cur.left, cur.right]) if (c) queue.push(c);
          steps.push({ queue: [...queue], current: cur, visited: [...visited], levels: levels.map((l) => [...l]), message: fmt(i === 0 ? s.newLevel : s.dequeue, { v: cur.key, l: level }) });
        }
        level++;
      }
    }
    let index = 0, timer: number | undefined;
    const draw = () => {
      const st = index ? steps[index - 1] : { queue: tree ? [tree] : [], visited: [], levels: [], message: s.initial } as Step;
      renderTree(svg, tree, (n) => (n === st.current ? 'active' : st.visited.includes(n) ? 'visit' : st.queue.includes(n) ? 'memo' : ''));
      $(root, '[data-queue]').textContent = st.queue.length ? `front → ${st.queue.map((n) => n.key).join(' ')} ← back` : '∅';
      $(root, '[data-levels]').textContent = st.levels.length ? st.levels.map((l) => `[${l.join(', ')}]`).join(' ') : '∅';
      $(root, '[data-readout]').textContent = index === steps.length ? s.done : st.message;
    };
    const stop = () => { clearInterval(timer); timer = undefined; $(root, '[data-play]').textContent = s.play; };
    const step = () => { if (index < steps.length) index++; draw(); if (index >= steps.length) stop(); };
    $(root, '[data-step]').addEventListener('click', step);
    $(root, '[data-play]').addEventListener('click', () => { if (timer) return stop(); if (index >= steps.length) index = 0; $(root, '[data-play]').textContent = s.pause; timer = window.setInterval(step, 700); });
    $(root, '[data-reset]').addEventListener('click', () => { stop(); index = 0; draw(); });
    draw();
  });
</script>
