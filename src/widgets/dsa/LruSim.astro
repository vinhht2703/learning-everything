---
import { strings, t } from '../../i18n/utils';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
const k = (key: string) => t(lang, `w.lru.${key}`);
---
<div class="ds-widget" data-widget="dsa-lru" data-strings={JSON.stringify(strings(lang, 'w.lru.'))}>
  <div class="ds-controls">
    <label>{k('key')}<input type="number" min="0" max="99" value="4" data-key /></label>
    <label>{k('capacity')}<select data-cap><option>2</option><option selected>3</option><option>4</option></select></label>
    <div class="ds-buttons">
      <button class="run-button" type="button" data-op="put">{k('put')}</button>
      <button class="reset-button" type="button" data-op="get">{k('get')}</button>
      <button class="reset-button" type="button" data-op="reset">↺</button>
    </div>
  </div>
  <div class="lru-view">
    <div><div class="graph-panel-title">{k('list')}</div><div class="ds-row ds-list" data-list></div></div>
    <div><div class="graph-panel-title">{k('map')}</div><code class="lru-map" data-map></code></div>
  </div>
  <div class="ds-stats"><div><span>{k('hits')}</span><strong data-hits>0</strong></div><div><span>{k('misses')}</span><strong data-misses>0</strong></div><div><span>{k('evictions')}</span><strong data-evictions>0</strong></div></div>
  <p class="ds-readout" aria-live="polite" data-readout>{k('initial')}</p>
</div>
<script>
  import { $, $$, eachWidget, fmt } from '../../lib/dom';
  eachWidget('dsa-lru', (root, s) => {
    let order: number[] = [], hits = 0, misses = 0, evictions = 0, hot = -1, evicted = -1;
    const cap = () => Number($<HTMLSelectElement>(root, '[data-cap]').value);
    const reset = () => { order = [1, 2, 3]; hits = misses = evictions = 0; hot = evicted = -1; $(root, '[data-readout]').textContent = s.initial; draw(); };
    const draw = () => {
      $(root, '[data-list]').innerHTML = `<span class="ds-tag">${s.lruEnd}</span>` +
        (order.map((k) => `<div class="ds-node${k === hot ? ' active' : ''}"><em>key</em><strong>${k}</strong></div>`).join('<span class="ds-arrow">⇄</span>') || `<div class="ds-empty">∅</div>`) +
        `<span class="ds-tag">${s.mruEnd}</span>` + (evicted >= 0 ? `<span class="lru-evicted">✕ ${evicted}</span>` : '');
      $(root, '[data-map]').textContent = `{ ${[...order].sort((x, y) => x - y).map((k) => `${k} → node`).join(', ')} }`;
      $(root, '[data-hits]').textContent = String(hits);
      $(root, '[data-misses]').textContent = String(misses);
      $(root, '[data-evictions]').textContent = String(evictions);
    };
    $$<HTMLButtonElement>(root, '[data-op]').forEach((b) => b.addEventListener('click', () => {
      const op = b.dataset.op!, key = Number($<HTMLInputElement>(root, '[data-key]').value);
      evicted = -1;
      if (op === 'reset') return reset();
      const i = order.indexOf(key);
      if (op === 'get') {
        if (i < 0) { misses++; hot = -1; $(root, '[data-readout]').textContent = fmt(s.miss, { k: key }); }
        else { hits++; order.splice(i, 1); order.push(key); hot = key; $(root, '[data-readout]').textContent = fmt(s.hit, { k: key }); }
      } else {
        if (i >= 0) order.splice(i, 1);
        order.push(key); hot = key;
        let msg = fmt(i >= 0 ? s.updated : s.inserted, { k: key });
        while (order.length > cap()) { evicted = order.shift()!; evictions++; msg += ' ' + fmt(s.evict, { k: evicted, c: cap() }); }
        $(root, '[data-readout]').textContent = msg;
      }
      draw();
    }));
    $<HTMLSelectElement>(root, '[data-cap]').addEventListener('change', () => { while (order.length > cap()) { evicted = order.shift()!; evictions++; } draw(); });
    reset();
  });
</script>
