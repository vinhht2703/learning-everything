---
import { strings, t } from '../../i18n/utils';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
const k = (key: string) => t(lang, `w.dfs.${key}`);
---
<div class="ds-widget" data-widget="dsa-dfs" data-strings={JSON.stringify(strings(lang, 'w.dfs.'))}>
  <div class="ds-controls">
    <label>{k('order')}<select data-order><option value="pre">{k('pre')}</option><option value="in" selected>{k('in')}</option><option value="post">{k('post')}</option></select></label>
    <div class="ds-buttons">
      <button class="run-button" type="button" data-step>{k('step')}</button>
      <button class="reset-button" type="button" data-play>{k('play')}</button>
      <button class="reset-button" type="button" data-reset>{k('reset')}</button>
    </div>
  </div>
  <svg class="ds-tree" viewBox="0 0 680 200" role="img" aria-label={k('aria')} data-svg></svg>
  <div class="ds-inorder"><span>{k('output')}</span><code data-output>∅</code></div>
  <p class="ds-readout" aria-live="polite" data-readout>{k('initial')}</p>
</div>
<script>
  import { $, eachWidget, fmt } from '../../lib/dom';
  import { bstInsert, inorder, postorder, preorder, renderTree, type TNode } from '../../lib/tree';
  eachWidget('dsa-dfs', (root, s) => {
    let tree: TNode | null = null;
    for (const v of [4, 2, 6, 1, 3, 5, 7]) tree = bstInsert(tree, v).root;
    const svg = $(root, '[data-svg]') as unknown as SVGElement, order = $<HTMLSelectElement>(root, '[data-order]');
    let seq: TNode[] = [], index = 0, timer: number | undefined;
    const draw = () => {
      const done = seq.slice(0, index), cur = done.at(-1);
      renderTree(svg, tree, (n) => (n === cur ? 'active' : done.includes(n) ? 'visit' : ''));
      $(root, '[data-output]').textContent = done.map((n) => n.key).join(' ') || '∅';
      $(root, '[data-readout]').textContent = !index ? fmt(s.initialOrder, { rule: s[`${order.value}Rule`] }) : index === seq.length ? fmt(s.done, { out: done.map((n) => n.key).join(' ') }) : fmt(s.visit, { v: cur!.key });
    };
    const stop = () => { clearInterval(timer); timer = undefined; $(root, '[data-play]').textContent = s.play; };
    const reset = () => { stop(); seq = order.value === 'pre' ? preorder(tree) : order.value === 'post' ? postorder(tree) : inorder(tree); index = 0; draw(); };
    const step = () => { if (index < seq.length) index++; draw(); if (index >= seq.length) stop(); };
    $(root, '[data-step]').addEventListener('click', step);
    $(root, '[data-play]').addEventListener('click', () => { if (timer) return stop(); if (index >= seq.length) index = 0; $(root, '[data-play]').textContent = s.pause; timer = window.setInterval(step, 650); });
    $(root, '[data-reset]').addEventListener('click', reset);
    order.addEventListener('change', reset);
    reset();
  });
</script>
