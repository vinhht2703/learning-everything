---
import { strings, t } from '../../i18n/utils';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
const k = (key: string) => t(lang, `w.bsearch.${key}`);
---
<div class="ds-widget" data-widget="dsa-bsearch" data-strings={JSON.stringify(strings(lang, 'w.bsearch.'))}>
  <div class="ds-controls">
    <label>{k('target')}<input type="number" value="23" data-target /></label>
    <div class="ds-buttons">
      <button class="run-button" type="button" data-step>{k('step')}</button>
      <button class="reset-button" type="button" data-reset>{k('reset')}</button>
    </div>
  </div>
  <div class="ds-row" data-cells aria-hidden="true"></div>
  <div class="ds-stats"><div><span>{k('checks')}</span><strong data-checks>0</strong></div><div><span>{k('linear')}</span><strong data-linear>–</strong></div></div>
  <p class="ds-readout" aria-live="polite" data-readout>{k('initial')}</p>
</div>
<script>
  import { $, eachWidget, fmt } from '../../lib/dom';
  const ARR = [2, 5, 8, 12, 16, 23, 38, 45, 56, 67, 72, 81, 90, 95, 99];
  eachWidget('dsa-bsearch', (root, s) => {
    let low = 0, high = ARR.length - 1, mid = -1, checks = 0, done = false, found = -1;
    const target = () => Number($<HTMLInputElement>(root, '[data-target]').value);
    const draw = () => {
      $(root, '[data-cells]').innerHTML = ARR.map((v, i) => {
        const tags = [i === low && !done ? 'L' : '', i === mid ? 'M' : '', i === high && !done ? 'R' : ''].filter(Boolean).join(' ');
        const cls = i === found ? 'found' : i === mid ? 'active' : i < low || i > high ? 'empty' : '';
        return `<div class="ds-cell ${cls}"><small>${i}</small><strong>${v}</strong><em>${tags || '&nbsp;'}</em></div>`;
      }).join('');
      $(root, '[data-checks]').textContent = String(checks);
      const lin = ARR.indexOf(target());
      $(root, '[data-linear]').textContent = String(lin >= 0 ? lin + 1 : ARR.length);
    };
    const reset = () => { low = 0; high = ARR.length - 1; mid = -1; checks = 0; done = false; found = -1; $(root, '[data-readout]').textContent = s.initial; draw(); };
    $(root, '[data-step]').addEventListener('click', () => {
      if (done) return;
      const tv = target();
      if (low > high) { done = true; mid = -1; $(root, '[data-readout]').textContent = fmt(s.missing, { t: tv, n: checks }); draw(); return; }
      mid = (low + high) >> 1; checks++;
      if (ARR[mid] === tv) { found = mid; done = true; $(root, '[data-readout]').textContent = fmt(s.found, { t: tv, i: mid, n: checks }); }
      else if (ARR[mid] < tv) { $(root, '[data-readout]').textContent = fmt(s.goRight, { v: ARR[mid], t: tv }); draw(); low = mid + 1; return draw(); }
      else { $(root, '[data-readout]').textContent = fmt(s.goLeft, { v: ARR[mid], t: tv }); draw(); high = mid - 1; return draw(); }
      draw();
    });
    $(root, '[data-reset]').addEventListener('click', reset);
    $(root, '[data-target]').addEventListener('input', reset);
    reset();
  });
</script>
