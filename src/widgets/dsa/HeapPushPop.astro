---
import { strings, t } from '../../i18n/utils';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
const k = (key: string) => t(lang, `w.heappp.${key}`);
---
<div class="ds-widget" data-widget="dsa-heap-pp" data-strings={JSON.stringify(strings(lang, 'w.heappp.'))}>
  <div class="ds-controls">
    <label>{k('value')}<input type="number" value="0" data-value /></label>
    <div class="ds-buttons">
      <button class="run-button" type="button" data-push>{k('push')}</button>
      <button class="reset-button" type="button" data-pop>{k('pop')}</button>
      <button class="reset-button" type="button" data-reset>↺</button>
    </div>
  </div>
  <svg class="ds-tree" viewBox="0 0 680 200" role="img" aria-label={k('aria')} data-svg></svg>
  <div class="ds-row" data-cells></div>
  <div class="ds-inorder"><span>{k('popped')}</span><code data-popped>∅</code></div>
  <p class="ds-readout" aria-live="polite" data-readout>{k('initial')}</p>
</div>
<script>
  import { $, eachWidget, fmt } from '../../lib/dom';
  import { drawHeap, parentOf } from '../../lib/heap';
  type Frame = { arr: number[]; hot: number[]; msg: string };
  eachWidget('dsa-heap-pp', (root, s) => {
    let arr = [2, 4, 3, 8, 5, 7], popped: number[] = [], timer: number | undefined, busy = false;
    const show = (f: Frame) => {
      drawHeap($(root, '[data-svg]') as unknown as SVGElement, $(root, '[data-cells]'), f.arr, (i) => (f.hot.includes(i) ? 'active' : i === 0 ? 'base' : ''));
      $(root, '[data-readout]').textContent = f.msg;
      $(root, '[data-popped]').textContent = popped.join(', ') || '∅';
    };
    const play = (frames: Frame[], done: () => void) => {
      busy = true; let i = 0;
      show(frames[0]);
      timer = window.setInterval(() => { i++; if (i >= frames.length) { clearInterval(timer); busy = false; done(); return; } show(frames[i]); }, 600);
    };
    $(root, '[data-push]').addEventListener('click', () => {
      if (busy) return;
      if (arr.length >= 15) { $(root, '[data-readout]').textContent = s.full; return; }
      const v = Number($<HTMLInputElement>(root, '[data-value]').value);
      const a = [...arr, v]; let i = a.length - 1; let swaps = 0;
      const frames: Frame[] = [{ arr: [...a], hot: [i], msg: fmt(s.added, { v, i }) }];
      while (i > 0 && a[parentOf(i)] > a[i]) {
        const p = parentOf(i);
        frames.push({ arr: [...a], hot: [i, p], msg: fmt(s.compareUp, { v: a[i], p: a[p] }) });
        [a[i], a[p]] = [a[p], a[i]]; i = p; swaps++;
        frames.push({ arr: [...a], hot: [i], msg: fmt(s.swappedUp, { v }) });
      }
      frames.push({ arr: [...a], hot: [i], msg: fmt(s.pushDone, { v, n: swaps }) });
      play(frames, () => { arr = a; });
    });
    $(root, '[data-pop]').addEventListener('click', () => {
      if (busy) return;
      if (!arr.length) { $(root, '[data-readout]').textContent = s.empty; return; }
      const a = [...arr], top = a[0];
      const frames: Frame[] = [{ arr: [...a], hot: [0], msg: fmt(s.takeRoot, { v: top }) }];
      a[0] = a[a.length - 1]; a.pop();
      if (a.length) frames.push({ arr: [...a], hot: [0], msg: fmt(s.lastToRoot, { v: a[0] }) });
      let i = 0, swaps = 0;
      while (true) {
        const l = 2 * i + 1, r = 2 * i + 2; let m = i;
        if (l < a.length && a[l] < a[m]) m = l;
        if (r < a.length && a[r] < a[m]) m = r;
        if (m === i) break;
        frames.push({ arr: [...a], hot: [i, m], msg: fmt(s.compareDown, { v: a[i], c: a[m] }) });
        [a[i], a[m]] = [a[m], a[i]]; i = m; swaps++;
      }
      frames.push({ arr: [...a], hot: a.length ? [i] : [], msg: fmt(s.popDone, { v: top, n: swaps }) });
      play(frames, () => { arr = a; popped.push(top); show({ arr, hot: [], msg: frames.at(-1)!.msg }); });
    });
    $(root, '[data-reset]').addEventListener('click', () => { clearInterval(timer); busy = false; arr = [2, 4, 3, 8, 5, 7]; popped = []; show({ arr, hot: [], msg: s.initial }); });
    show({ arr, hot: [], msg: s.initial });
  });
</script>
