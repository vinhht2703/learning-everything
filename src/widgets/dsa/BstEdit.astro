---
import { strings, t } from '../../i18n/utils';
import type { WidgetProps } from '../types';
type Props = WidgetProps;
const { lang } = Astro.props;
const k = (key: string) => t(lang, `w.bstedit.${key}`);
---
<div class="ds-widget" data-widget="dsa-bst-edit" data-strings={JSON.stringify(strings(lang, 'w.bstedit.'))}>
  <div class="ds-controls">
    <label>{k('value')}<input type="number" value="5" data-value /></label>
    <div class="ds-buttons">
      <button class="run-button" type="button" data-insert>{k('insert')}</button>
      <button class="reset-button" type="button" data-remove>{k('remove')}</button>
      <button class="reset-button" type="button" data-reset>↺</button>
    </div>
  </div>
  <svg class="ds-tree" viewBox="0 0 680 240" role="img" aria-label={k('aria')} data-svg></svg>
  <div class="ds-inorder"><span>{k('inorder')}</span><code data-inorder></code></div>
  <p class="ds-readout" aria-live="polite" data-readout>{k('initial')}</p>
</div>
<script>
  import { $, eachWidget, fmt } from '../../lib/dom';
  import { bstInsert, bstRemove, inorder, renderTree, type TNode } from '../../lib/tree';
  eachWidget('dsa-bst-edit', (root, s) => {
    let tree: TNode | null = null;
    const svg = $(root, '[data-svg]') as unknown as SVGElement;
    const draw = (cls: (n: TNode) => string = () => '') => {
      renderTree(svg, tree, cls);
      $(root, '[data-inorder]').textContent = inorder(tree).map((n) => n.key).join(' → ') || '∅';
    };
    const reset = () => { tree = null; for (const v of [8, 3, 10, 1, 6, 14, 4, 7]) tree = bstInsert(tree, v).root; $(root, '[data-readout]').textContent = s.initial; draw(); };
    const value = () => Number($<HTMLInputElement>(root, '[data-value]').value);
    $(root, '[data-insert]').addEventListener('click', () => {
      if (inorder(tree).length >= 15) { $(root, '[data-readout]').textContent = s.full; return; }
      const v = value(), res = bstInsert(tree, v);
      tree = res.root;
      const newId = res.path.at(-1);
      draw((n) => (n.id === newId && !res.updated ? 'found' : res.path.includes(n.id) ? 'visit' : ''));
      $(root, '[data-readout]').textContent = res.updated ? fmt(s.exists, { v }) : fmt(s.inserted, { v, n: res.path.length - 1 });
    });
    $(root, '[data-remove]').addEventListener('click', () => {
      const v = value(), res = bstRemove(tree, v);
      tree = res.root;
      draw((n) => (res.successor !== undefined && n.key === res.successor ? 'found' : ''));
      $(root, '[data-readout]').textContent = fmt(s[res.kase], { v, s: res.successor ?? '' });
    });
    $(root, '[data-reset]').addEventListener('click', reset);
    reset();
  });
</script>
